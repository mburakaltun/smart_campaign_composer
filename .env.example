# Copy to .env (docker compose reads it automatically). Never commit .env.

# Leave empty to use the built-in mock LLM (works offline, deterministic).
# Set a key from https://console.anthropic.com to use real Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force a mode: "mock" or "anthropic" (default: anthropic if a key is set, else mock)
LLM_PROVIDER=

# Delivery
RATE_PER_SEC=100            # max messages per second, per channel
SEED_USERS=4000             # fake customers created on first start

# Mock provider chaos (fractions of requests)
PROVIDER_ERROR_RATE=0.05    # HTTP 503
PROVIDER_429_RATE=0.03      # HTTP 429 + Retry-After
PROVIDER_TIMEOUT_RATE=0.005 # delivered but the reply arrives too late (client times out)
PROVIDER_LIMIT_PER_SEC=150  # hard provider-side limit per channel
